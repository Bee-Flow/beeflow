# Bee Flow server — environment template
#
# Copy to `.env` and fill in. The server FAILS TO BOOT if required vars
# are missing; this is intentional — silent fallbacks to predictable
# defaults are how secrets get effectively published.

# ─────────────────────────────────────────────────────────────────
# REQUIRED — server WILL refuse to start without these
# ─────────────────────────────────────────────────────────────────

# Master signing/encryption seed. Used for:
#   - express-session cookie signing (account-takeover risk if predictable)
#   - AES-256-GCM key for OAuth-token storage in ticket_assistant_connections
#   - HMAC for time-limited storage download URLs
#   - MS-Graph subscription clientState (CSRF protection)
# Generate a fresh one (≥32 chars; 64+ recommended):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ROTATING THIS INVALIDATES existing sessions and breaks decryption of
# already-stored OAuth tokens — re-link integrations after rotation.
SESSION_SECRET=

# PostgreSQL connection string. The server creates its own tables on boot.
DATABASE_URL=postgresql://beeflow:CHANGE_ME@localhost:5432/beeflow_core

# ─────────────────────────────────────────────────────────────────
# Strongly recommended in production
# ─────────────────────────────────────────────────────────────────

# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGIN=https://app.example.com

# Force secure cookies (HTTPS-only). Defaults to true when NODE_ENV=production.
# Set explicitly to 'false' only in dev where you serve over plain HTTP.
COOKIE_SECURE=true

# Cookie SameSite policy. Use 'strict' if you don't need cross-site OAuth
# popups; 'lax' is the safe default that still allows top-level navigations.
COOKIE_SAMESITE=lax

# If your frontend lives on a sibling sub-domain (api.x.com vs app.x.com),
# set the parent domain so cookies are shared. Leave blank otherwise.
# COOKIE_DOMAIN=.example.com

# Set to 'production' to enable secure cookie defaults + drop dev logging.
NODE_ENV=production

# ─────────────────────────────────────────────────────────────────
# Optional integrations
# ─────────────────────────────────────────────────────────────────

# Redis read-through cache layer over the PG session store. Optional;
# the server falls back to PG-only sessions when REDIS_URL is unset.
# REDIS_URL=redis://localhost:6379

# Distinct secret for MS-Graph subscription clientState HMAC. If unset
# the code reuses SESSION_SECRET — fine for single-tenant; set this if
# you want independent rotation.
# MSGRAPH_CLIENT_STATE_SECRET=

# OPAQUE PAKE — optional; generate via:
#   node -e "require('./auth/opaque').generateSetup()"
# OPAQUE_SERVER_SETUP=

# Public base URL (used for outgoing webhooks / callback URLs).
# PUBLIC_BASE_URL=https://api.example.com
# CLIENT_PUBLIC_HOST=app.example.com
# CLIENT_PROTOCOL=https

# AI/LLM (one of the providers configured at runtime via the admin UI).
# LLM_API_URL=
# LLM_API_KEY=

# Reranker (Azure Cohere preferred; local sidecar fallback)
# AZURE_RERANKER_ENDPOINT=
# AZURE_RERANKER_KEY=
# AZURE_RERANKER_MODEL=Cohere-rerank-v4.0-fast
# RERANKER_URL=http://reranker:8000

# Self-registration toggles
ALLOW_SIGNUPS=true
ALLOW_PASSWORD_LOGIN=true
DEPLOYMENT_MODE=cloud
