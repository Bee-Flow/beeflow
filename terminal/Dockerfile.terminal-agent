FROM python:3.11-slim

# Install common utilities
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    bash \
    curl \
    wget \
    git \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set up workspace
WORKDIR /workspace

# Keep container alive — commands are executed via `docker exec`
CMD ["sleep", "infinity"]
